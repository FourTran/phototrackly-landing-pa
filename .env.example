NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics uses the public measurement ID defined in lib/analytics.ts.
# Optional analytics loads only after the visitor grants analytics consent.

# Server-only Google Apps Script web app. No database is required.
# Deploy integrations/google-apps-script/Code.gs using docs/GOOGLE-SHEETS-LEADS.md.
LEAD_WEBHOOK_URL=
# Must match the Apps Script WEBHOOK_SECRET property; at least 32 random characters.
# Keep stable. Never prefix with NEXT_PUBLIC_ or commit the real value.
LEAD_WEBHOOK_SECRET=
